# Пример переменных окружения. Скопируй в .env и заполни СВОИМИ значениями.
# Файл .env — в .gitignore. НИКОГДА не коммить реальные ключи, пароли, токены.
#
# Подгрузить в текущую сессию shell:
#   set -a; source .env; set +a

# --- MetaTrader 5 (advanced/mt5_connector.py) — ТОЛЬКО ДЕМО-СЧЁТ ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Telegram-оповещения (advanced/telegram_alerts.py, coach_bot.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Путь к журналу сделок (tools/journal_cli.py), опционально ---
# FOREX_JOURNAL=/абсолютный/путь/к/my-trades.csv
